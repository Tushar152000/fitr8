{
  "expo": {
    "name": "FITR8",
    "slug": "fitlens",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitlens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fitr8.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "package": "com.fitr8.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ELEVATION_GAINED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-wordmark-black.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#0c0c0c",
            "image": "./assets/images/splash-wordmark-white.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "FITR8 uses the camera to photograph your meals, barcodes, nutrition labels and your profile photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FITR8 opens a photo you pick to read your meal or a nutrition label, or to use as your profile photo.",
          "cameraPermission": "FITR8 uses the camera to photograph your meals, barcodes, nutrition labels and your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#718B00"
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FITR8 reads your steps, heart rate, sleep, blood oxygen, body measurements and workouts from Apple Health to show them in the app, estimate your recovery and tailor your training. FITR8 never writes to Apple Health and never uses this data for advertising.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FITR8 uses the microphone only when you tap the mic to talk to your coach, to turn what you say into text.",
          "speechRecognitionPermission": "FITR8 turns what you say to your coach into text so you don't have to type.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5e24b4b-ca8d-486a-9b73-e76452f9b624"
      }
    },
    "owner": "mrdoodler",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b5e24b4b-ca8d-486a-9b73-e76452f9b624"
    }
  }
}
